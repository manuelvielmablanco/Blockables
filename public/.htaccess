# ──────────────────────────────────────────────────────────────────────────
# Apache/SiteGround config para Ingeniables Blocks (SPA en subdirectorio)
# ──────────────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
  RewriteEngine On

  # No reescribir nunca peticiones a /assets/, /fonts/ ni /characters/.
  # Si un asset con hash no existe (build vieja), debe devolver un 404 REAL,
  # nunca el index.html. Un 404 con cuerpo HTML hace que el navegador intente
  # ejecutar HTML como módulo JS → SyntaxError silencioso → pantalla en blanco.
  RewriteRule ^assets/     - [L]
  RewriteRule ^fonts/      - [L]
  RewriteRule ^characters/ - [L]
  RewriteRule ^kits/       - [L]

  # Resto: si la ruta no es archivo ni directorio físico → index.html
  # (necesario para el routing client-side).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# ──────────────────────────────────────────────────────────────────────────
# Cache headers
# ──────────────────────────────────────────────────────────────────────────
# Los assets de /assets/, /fonts/ y /characters/ tienen nombre con hash de
# contenido (Vite los fingerprinta), así que pueden cachearse para siempre.
# index.html, en cambio, debe revalidarse siempre — si lo cacheamos, el
# navegador puede seguir pidiendo hashes de JS/CSS que ya no existen tras
# un nuevo deploy.

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|otf|eot|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    # SiteGround Dynamic Cache (su proxy NGINX por encima de Apache) ignora
    # Cache-Control para HTML por defecto: cachea respuestas durante horas.
    # Para que NO cachee este HTML hay que añadir el header propietario que
    # SiteGround sí honra. Sin esto, los hashes hash-fingerprinted de Vite
    # quedan obsoletos en el cache de SiteGround tras cada deploy y los
    # clientes piden bundles que ya no existen → pantalla en blanco.
    Header set X-Cache-Enabled "False"
  </FilesMatch>

  <FilesMatch "\.htaccess$">
    Require all denied
  </FilesMatch>
</IfModule>

# Compresión (SiteGround normalmente la maneja, pero por si acaso)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
